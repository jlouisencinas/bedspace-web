# dependencies
node_modules/

# build output
dist/

# local env (secrets) — never commit
.env
.env.local
.env.*.local

# logs
npm-debug.log*
*.log

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code: the pipeline's agents, hooks, skills and shared settings are tracked; local settings are not.
# design-taste-frontend is a third-party skill, installed separately.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/skills/
.claude/skills/design-taste-frontend/
!.claude/settings.json
!.claude/launch.json
.agents/
skills-lock.json

# Local email previews (scripts/preview-approval-email.mjs)
.email-preview/

# Agent pipeline task folders (plans, reviews, test reports)
.pipeline/
